#
#xfce-mcs-manager &

picom &
~/.scripts/xorg_layouts/monitorsonly.sh
feh --bg-fill ~/.config/openbox/bg.jpg

(sleep 5s && /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1) &
(sleep 5s && polybar main) &
(sleep 5s && polybar offbar1) &
(sleep 5s && nextcloud) &
(sleep 10s && redshift-gtk -l 51.6:4.6) &
(sleep 10s && XDG_MENU_PREFIX=arch- kbuildsycoca6 --noincremental) &
(sleep 10s && flameshot) &
(sleep 10s && hydrus-client) &
